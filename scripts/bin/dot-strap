#!/usr/bin/env bash
# Install development dependencies on macOS. Run as your login user.
set -euo pipefail

case "${1:-}" in
  --debug) set -x ;;
  "") ;;
  *) echo "Usage: $0 [--debug]" >&2; exit 1 ;;
esac

[[ "$(uname -s)" == Darwin ]] || { echo "This script requires macOS." >&2; exit 1; }
[[ "$(id -u)" != 0 ]] || { echo "Run dot-strap as yourself, not with sudo." >&2; exit 1; }
if [[ "$(sysctl -in sysctl.proc_translated 2>/dev/null || true)" == 1 ]]; then
  echo "Run dot-strap from a native terminal, not under Rosetta." >&2
  exit 1
fi

DOTFILES="$HOME/.dotfiles"
[[ -d "$DOTFILES" ]] || { echo "Clone the dotfiles into $DOTFILES first." >&2; exit 1; }

# Accept either full Xcode or Command Line Tools, using the selected SDK.
echo "==> Checking developer tools..."
if ! xcode-select -p >/dev/null 2>&1; then
  if [[ -t 0 ]]; then
    xcode-select --install
  fi
  echo "Install Command Line Tools with 'xcode-select --install', then rerun dot-strap." >&2
  exit 1
fi
xcrun --sdk macosx --show-sdk-path
xcrun clang --version

# Prevent sleep on AC power while setup is running.
caffeinate -s -w "$$" &

# Let sudo handle passwords and Touch ID; never store credentials in a file.
sudo -v

echo "==> Configuring Touch ID for sudo..."
if [[ -f /etc/pam.d/sudo_local.template ]]; then
  if [[ ! -f /etc/pam.d/sudo_local ]]; then
    sudo cp -p /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local
  fi
  if grep -Eq '^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so([[:space:]]|$)' /etc/pam.d/sudo_local; then
    echo "Touch ID is already enabled for sudo."
  elif grep -Eq '^#[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so([[:space:]]|$)' /etc/pam.d/sudo_local; then
    # Only enable Apple's existing rule; leave custom PAM configurations alone.
    sudo sed -i .bak -E 's/^#[[:space:]]*(auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so([[:space:]]|$))/\1/' /etc/pam.d/sudo_local
  else
    echo "No standard Touch ID rule found; leaving sudo_local unchanged."
  fi
fi

echo "==> Enabling the application firewall..."
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on
/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate

echo "==> Checking FileVault..."
FILEVAULT_STATUS="$(fdesetup status)"
echo "$FILEVAULT_STATUS"
if [[ "$FILEVAULT_STATUS" == *"FileVault is Off."* ]]; then
  echo "Enable FileVault in System Settings > Privacy & Security > FileVault."
  echo "Store the recovery key securely, not in a plaintext Desktop file."
fi
echo "In System Settings > Lock Screen, require a password immediately after sleep or screen saver."

# Reuse existing Homebrew (including Workbrew), even if it is not yet on PATH.
if [[ -x /opt/workbrew/bin/brew ]]; then
  export PATH="/opt/workbrew/bin:$PATH"
elif ! command -v brew >/dev/null 2>&1; then
  for prefix in /opt/homebrew /usr/local; do
    if [[ -x "$prefix/bin/brew" ]]; then
      export PATH="$prefix/bin:$PATH"
      break
    fi
  done
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "==> Installing Homebrew..."
  HOMEBREW_INSTALLER="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  /bin/bash -c "$HOMEBREW_INSTALLER"
  if [[ "$(uname -m)" == arm64 ]]; then
    export PATH="/opt/homebrew/bin:$PATH"
  else
    export PATH="/usr/local/bin:$PATH"
  fi
fi
HOMEBREW_SHELLENV="$(brew shellenv)"
eval "$HOMEBREW_SHELLENV"

echo "==> Updating Homebrew and installing the Brewfile..."
brew update
# Always run Bundle to apply declared trust, even when packages are installed.
brew bundle --file "$DOTFILES/brew/.Brewfile"

"$DOTFILES/scripts/bin/dot-stow"

echo "==> Bootstrap finished. Run $DOTFILES/scripts/bin/dot-setup next (without sudo)."
echo "Review macOS and developer-tool updates in System Settings > General > Software Update."
