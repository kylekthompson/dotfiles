#!/usr/bin/env bash

set -euo pipefail

[[ "$(uname -s)" == Darwin ]] || { echo "This script requires macOS." >&2; exit 1; }
[[ "$(id -u)" != 0 ]] || { echo "Run dot-setup as yourself, not with sudo." >&2; exit 1; }

DOTFILES="$HOME/.dotfiles"
export PATH="$HOME/.local/bin:$PATH"
if [[ -x /opt/workbrew/bin/brew ]]; then
  export PATH="/opt/workbrew/bin:$PATH"
elif ! command -v brew >/dev/null 2>&1; then
  for prefix in /opt/homebrew /usr/local; do
    if [[ -x "$prefix/bin/brew" ]]; then
      export PATH="$prefix/bin:$PATH"
      break
    fi
  done
fi
command -v brew >/dev/null 2>&1 || { echo "Run dot-strap first to install Homebrew." >&2; exit 1; }
HOMEBREW_SHELLENV="$(brew shellenv)"
eval "$HOMEBREW_SHELLENV"

echo "==> Installing from the Brewfile..."
# Always run Bundle to apply declared trust, even when packages are installed.
brew bundle --file "$DOTFILES/brew/.Brewfile"
"$DOTFILES/scripts/bin/dot-stow"

# Noninteractive setup needs the same build environment as a new Zsh terminal.
# shellcheck source=terminal/.config/shell/development.sh
source "$HOME/.config/shell/development.sh"

echo "==> Ensuring zsh is the default shell..."
ZSH_SHELL="$(brew --prefix)/bin/zsh"
[[ -x "$ZSH_SHELL" ]] || { echo "zsh is not installed at $ZSH_SHELL." >&2; exit 1; }
if grep -Fxq "$ZSH_SHELL" /etc/shells; then
  echo "Zsh is already in /etc/shells"
else
  echo "Adding zsh to /etc/shells..."
  printf '%s\n' "$ZSH_SHELL" | sudo tee -a /etc/shells >/dev/null
fi

LOGIN_SHELL="$(dscl . -read "/Users/$(id -un)" UserShell | awk '{print $2}')"
if [[ "$LOGIN_SHELL" == "$ZSH_SHELL" ]]; then
  echo "Zsh is already your login shell"
else
  chsh -s "$ZSH_SHELL"
fi

echo "==> Installing default tools via mise"
(
  cd "$HOME"
  mise install
)

if ! command -v claude &>/dev/null; then
  echo "==> Installing Claude Code..."
  CLAUDE_INSTALLER="$(curl -fsSL https://claude.ai/install.sh)"
  /bin/bash -c "$CLAUDE_INSTALLER"
fi

echo "==> Installing Mac App Store apps (sign in to the App Store first)..."
mas install 937984704 # Amphetamine
mas install 441258766 # Magnet
mas install 1056643111 # Clocker

echo "==> Setup finished. Open a new terminal to use zsh."
