#!/usr/bin/env bash

set -euo pipefail

[[ "$(id -u)" != 0 ]] || { echo "Run dot-stow as yourself, not with sudo." >&2; exit 1; }

echo
echo "==> Running stow..."
echo

pushd "$HOME/.dotfiles" &>/dev/null
stow --restow --target "$HOME" ai brew editor git mise nvim psql ruby scripts ssh terminal

# macOS can't follow symlinks for fonts, so we'll fake stowing them
if [[ "$(uname -s)" == Darwin ]]; then
  mkdir -p "$HOME/Library/Fonts"
  for font in fonts/*; do
    [[ -f "$font" ]] || continue
    cp "$font" "$HOME/Library/Fonts/"
  done
fi

popd &>/dev/null
