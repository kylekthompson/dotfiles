#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077

if [[ $# -ne 0 ]]; then
  echo "Usage: aws-credentials (Scratch account only; no arguments)" >&2
  exit 2
fi

token_file="$(mktemp)"
trap 'rm -f "$token_file"' EXIT

amp orb id-token \
  --audience urn:amp:aws:scratch-admin:863518447294 \
  --subject-scope project > "$token_file"

aws sts assume-role-with-web-identity \
  --no-sign-request \
  --endpoint-url https://sts.us-east-1.amazonaws.com \
  --region us-east-1 \
  --role-arn arn:aws:iam::863518447294:role/amp-scratch-admin \
  --role-session-name amp-scratch-admin \
  --duration-seconds 3600 \
  --web-identity-token "file://$token_file" \
  --output json \
  --no-cli-pager | python3 -c '
import json
import sys

credentials = json.load(sys.stdin)["Credentials"]
print(json.dumps({
    "Version": 1,
    "AccessKeyId": credentials["AccessKeyId"],
    "SecretAccessKey": credentials["SecretAccessKey"],
    "SessionToken": credentials["SessionToken"],
    "Expiration": credentials["Expiration"],
}))
'
